# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN di-commit ke Git.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=bacain_app
DB_PASSWORD=12345
DB_NAME=bacain

# String acak panjang untuk menandatangani token login.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
